{
  "name": "workwoven",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:db": "bash scripts/test-database.sh",
    "db:check": "node --env-file=.env.local scripts/migrate.mjs --check",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs --apply",
    "test:integration": "node --env-file=.env.local node_modules/@playwright/test/cli.js test --config playwright.integration.config.ts",
    "test:integration:cleanup": "node --env-file=.env.local scripts/cleanup-integration.mjs",
    "test:providers": "node --env-file=.env.local node_modules/@playwright/test/cli.js test --config playwright.providers.config.ts"
  },
  "dependencies": {
    "@bryntum/calendar-enterprise": "8.0.0",
    "@bryntum/calendar-react-enterprise": "8.0.0",
    "@bryntum/core-enterprise": "8.0.0",
    "@bryntum/gantt-enterprise": "8.0.0",
    "@bryntum/gantt-react-enterprise": "8.0.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.68.0",
    "next": "16.4.5",
    "openai": "^6.49.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "node": "^22.23.4",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}

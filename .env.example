NEXT_PUBLIC_APP_NAME=Workspace
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Comma-separated verified emails permitted to use /admin. Server-only.
ADMIN_EMAILS=
OPENAI_API_KEY=
OPENAI_MODEL=
PAYPAL_ENVIRONMENT=sandbox
# Optional Partner-app OAuth diagnostic only; not required for no-commission payments.
SANDBOX_PAYPAL_PARTNER_CLIENT_ID=
SANDBOX_PAYPAL_PARTNER_CLIENT_SECRET=
# Platform merchant for prepaid AI credit sales (checkout still unimplemented).
PAYPAL_CREDITS_CLIENT_ID=
PAYPAL_CREDITS_CLIENT_SECRET=
PAYPAL_CREDITS_MERCHANT_ID=
PAYPAL_CREDITS_WEBHOOK_ID=
# Bryntum 8 runtime licence, used by the browser. Keep the real key in .env.local.
NEXT_PUBLIC_BRYNTUM_LICENSE_KEY=
MAINTENANCE_SECRET=
# Local demo seed only; never reuse a real password.
SEED_PASSWORD=

# Database connection URI from Supabase Connect (direct or session pooler), server-only.
# Remote TLS defaults to verify-full; configure PGSSLROOTCERT if required.
SUPABASE_DB_URL=

# Path to the public Supabase CA downloaded from Database Settings (for psql verification).
PGSSLROOTCERT=

# Explicitly enable only after provider/metering validation.
AI_ENABLED=false
# Seeded pricing supports gpt-5-mini-2025-08-07 and gpt-6-luna at Standard tier.
# GPT-6 Luna uses explicit-only caching with no breakpoints (no cache writes).
# Other models require a new verified ai_pricing version.
